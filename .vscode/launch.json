{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Example (select)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/${input:subProject}/build/${input:exampleTarget}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/${input:subProject}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Example (select)",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ],
    "inputs": [
        {
            "id": "exampleTarget",
            "type": "pickString",
            "description": "选择要调试的 mbedTLS 示例 (01-08: mbedtls_36, 09-15: mbedtls_42)",
            "default": "01_hash",
            "options": [
                "01_hash",
                "02_aes",
                "03_rsa",
                "04_ecc",
                "05_x509_parse",
                "06_tls_client",
                "07_tls_mutual",
                "08_custom_bio",
                "09_psa_hash",
                "10_psa_cipher",
                "11_psa_aead",
                "12_psa_mac",
                "13_psa_asymmetric",
                "14_psa_kdf",
                "15_psa_key_mgmt"
            ]
        }
    ]
}
