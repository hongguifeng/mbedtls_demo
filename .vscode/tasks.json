{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build All (36 + 42)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/build.sh"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build both sub-projects via root build.sh"
        },

        {
            "label": "Clean Build (36 + 42)",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "${workspaceFolder}/mbedtls_36/build/*",
                "${workspaceFolder}/mbedtls_42/build/*"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Clean both sub-project build directories"
        },
        {
            "label": "Configure CMake (mbedtls_36)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/mbedtls_36/build",
                "-S",
                "${workspaceFolder}/mbedtls_36",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Configure mbedtls_36 CMake project"
        },
        {
            "label": "Configure CMake (mbedtls_42)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/mbedtls_42/build",
                "-S",
                "${workspaceFolder}/mbedtls_42",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Configure mbedtls_42 CMake project"
        },
        {
            "label": "Build Example (select)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "t='${input:exampleTarget}'; case \"$t\" in 0[1-8]*) d=mbedtls_36 ;; *) d=mbedtls_42 ;; esac; cmake --build \"${workspaceFolder}/$d/build\" --target \"$t\""
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Pick an example (01-15), auto-detect sub-project and build it"
        },
        {
            "label": "Run Example (select)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "t='${input:exampleTarget}'; case \"$t\" in 0[1-8]*) d=mbedtls_36 ;; *) d=mbedtls_42 ;; esac; cd \"${workspaceFolder}/$d\" && ./build/$t"
            ],
            "problemMatcher": [],
            "detail": "Pick an example (01-15), auto-detect sub-project and run it"
        },

        {
            "label": "Build 09 Embedded (STM32F407)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd \"${workspaceFolder}/mbedtls_36/09_embedded_stm32\" && ./build.sh"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Cross-build 09 firmware for STM32F407VE (Cortex-M4F) → build-arm/"
        },
        {
            "label": "Build 09 Embedded (QEMU)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd \"${workspaceFolder}/mbedtls_36/09_embedded_stm32\" && ./build.sh qemu"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Cross-build 09 firmware for QEMU mps2-an385 (Cortex-M3) → build-qemu/"
        },
        {
            "label": "Build 16 Embedded (STM32F407)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd \"${workspaceFolder}/mbedtls_42/16_embedded_stm32\" && ./build.sh"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Cross-build 16 firmware for STM32F407VE (Cortex-M4F) → build-arm/"
        },
        {
            "label": "Build 16 Embedded (QEMU)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd \"${workspaceFolder}/mbedtls_42/16_embedded_stm32\" && ./build.sh qemu"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Cross-build 16 firmware for QEMU mps2-an385 (Cortex-M3) → build-qemu/"
        },
        {
            "label": "Run 09 Embedded (QEMU)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd \"${workspaceFolder}/mbedtls_36/09_embedded_stm32\" && ./run_qemu.sh --debug"
            ],
            "problemMatcher": [],
            "presentation": {
                "panel": "new",
                "reveal": "always",
                "focus": true,
                "group": "qemu"
            },
            "detail": "Start 09 firmware in detached QEMU mps2-an385 (GDB stub :1234, CPU held at reset; serial → build-qemu/qemu_debug.log), then exit. preLaunchTask for Debug 09 Embedded (QEMU)"
        },
        {
            "label": "Run 16 Embedded (QEMU)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd \"${workspaceFolder}/mbedtls_42/16_embedded_stm32\" && ./run_qemu.sh --debug"
            ],
            "problemMatcher": [],
            "presentation": {
                "panel": "new",
                "reveal": "always",
                "focus": true,
                "group": "qemu"
            },
            "detail": "Start 16 firmware in detached QEMU mps2-an385 (GDB stub :12349, CPU held at reset; serial → build-qemu/qemu_debug.log), then exit. preLaunchTask for Debug 16 Embedded (QEMU)"
        },
        {
            "label": "Stop Embedded QEMU",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "pkill -f 'qemu-system-arm.*mps2-an385' 2>/dev/null || true"
            ],
            "problemMatcher": [],
            "detail": "Terminate all mps2-an385 QEMU instances (used as postDebugTask)"
        }
    ],
    "inputs": [
        {
            "id": "exampleTarget",
            "type": "pickString",
            "description": "选择要构建/运行的 mbedTLS 示例 (01-08: mbedtls_36, 09-15: mbedtls_42)",
            "options": [
                "01_hash",
                "02_aes",
                "03_rsa",
                "04_ecc",
                "05_x509_parse",
                "06_tls_client",
                "07_tls_mutual",
                "08_custom_bio",
                "09_psa_hash",
                "10_psa_cipher",
                "11_psa_aead",
                "12_psa_mac",
                "13_psa_asymmetric",
                "14_psa_kdf",
                "15_psa_key_mgmt"
            ]
        }
    ]
}
