{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build All (36 + 42)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/build.sh"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build both sub-projects via root build.sh"
        },
        {
            "label": "Build All (mbedtls_36)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/mbedtls_36/build"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build all mbedtls_36 targets"
        },
        {
            "label": "Build All (mbedtls_42)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/mbedtls_42/build"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build all mbedtls_42 targets"
        },
        {
            "label": "Clean Build (36 + 42)",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "${workspaceFolder}/mbedtls_36/build/*",
                "${workspaceFolder}/mbedtls_42/build/*"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Clean both sub-project build directories"
        },
        {
            "label": "Configure CMake (mbedtls_36)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/mbedtls_36/build",
                "-S",
                "${workspaceFolder}/mbedtls_36",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Configure mbedtls_36 CMake project"
        },
        {
            "label": "Configure CMake (mbedtls_42)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/mbedtls_42/build",
                "-S",
                "${workspaceFolder}/mbedtls_42",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Configure mbedtls_42 CMake project"
        },
        {
            "label": "Build Example (select)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "t='${input:exampleTarget}'; case \"$t\" in 0[1-8]*) d=mbedtls_36 ;; *) d=mbedtls_42 ;; esac; cmake --build \"${workspaceFolder}/$d/build\" --target \"$t\""
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Pick an example (01-15), auto-detect sub-project and build it"
        }
    ],
    "inputs": [
        {
            "id": "exampleTarget",
            "type": "pickString",
            "description": "选择要构建/调试的 mbedTLS 示例 (01-08: mbedtls_36, 09-15: mbedtls_42)",
            "default": "01_hash",
            "options": [
                "01_hash",
                "02_aes",
                "03_rsa",
                "04_ecc",
                "05_x509_parse",
                "06_tls_client",
                "07_tls_mutual",
                "08_custom_bio",
                "09_psa_hash",
                "10_psa_cipher",
                "11_psa_aead",
                "12_psa_mac",
                "13_psa_asymmetric",
                "14_psa_kdf",
                "15_psa_key_mgmt"
            ]
        }
    ]
}
